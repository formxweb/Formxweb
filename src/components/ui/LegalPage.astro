---
/** Shell for the legal pages: title, last update, the three documents side by side. */
import Base from '../../layouts/Base.astro';
import PageHead from './PageHead.astro';
import { legalLinks, site } from '../../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const updated = new Date(`${site.legal.updated}T12:00:00Z`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={title} description={description} breadcrumbs={[{ name: title, path }]} act={{ no: '§', name: 'Yasal' }}>
  <PageHead crumbs={[{ name: title }]} eyebrow={`Son güncelleme: ${updated}`} title={title} />
  <div class="grid lg">
    <nav class="lg__nav" aria-label="Yasal metinler">
      <ul role="list" class="t-micro">
        {legalLinks.map((l) => <li><a href={l.href} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="lg__body prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .lg { row-gap: 32px; padding-bottom: clamp(72px, 9vw, 144px); border-top: 1px solid var(--line-2); padding-top: clamp(28px, 4vw, 56px); }
  .lg__nav { grid-column: 1 / -1; }
  .lg__nav ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .lg__nav a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 12px; border: 1px solid var(--line-2); }
  .lg__nav a[aria-current] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .lg__body { grid-column: 1 / -1; min-width: 0; }
  .lg__body > :global(:first-child) { margin-top: 0; }
  @media (min-width: 1024px) {
    .lg__nav { grid-column: 1 / 4; }
    .lg__nav ul { flex-direction: column; position: sticky; top: calc(var(--header-h) + 24px); }
    .lg__nav a { border: 0; border-top: 1px solid var(--line); padding: 0; min-height: 44px; }
    .lg__nav a[aria-current] { background: none; color: var(--axis); }
    .lg__body { grid-column: 5 / 12; }
  }
</style>
