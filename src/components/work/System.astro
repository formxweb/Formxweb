---
/* 05 — System: the sale read along the X axis, from shop window to admin panel. */
import type { Project } from '../../data/projects';
import Shot from '../Shot.astro';
import ProjectMeta from './ProjectMeta.astro';
import ProjectText from './ProjectText.astro';

interface Props { project: Project }
const { project: p } = Astro.props;
const steps = [
  { shot: p.shots[0], label: 'Vitrin' },
  { shot: p.shots[1], label: 'Katalog' },
  { shot: p.shots[2], label: 'Kişiselleştirme' },
  { shot: p.shots[3], label: 'Yönetim paneli' },
];
---

<article
  class:list={['pj sys', p.theme.dark && 'on-dark']}
  id={`p-${p.slug}`}
  aria-labelledby={`p-${p.slug}-name`}
  style={`--p-bg:${p.theme.bg};--p-fg:${p.theme.fg};--p-accent:${p.theme.accent};--p-accent-ink:${p.theme.accentInk ?? p.theme.accent}`}
>
  <div class="grid sys__head">
    <ProjectMeta project={p} class="sys__meta" />
    <h3 class="pj-name pj-name--y sys__name" id={`p-${p.slug}-name`} lang={p.nameLang} data-reveal="mask">{p.name}</h3>
  </div>

  <ol class="sys__flow wrap" role="list" aria-label="Satış akışı">
    {
      steps.map((s, i) => (
        <li data-reveal="x" style={`--d:${i}`}>
          <span class="t-micro sys__n">0{i + 1}</span>
          <span class="sys__label">{s.label}</span>
        </li>
      ))
    }
  </ol>

  <div class="grid sys__screens">
    {
      steps.map((s, i) => (
        <a
          class={`case-link sys__s sys__s--${i + 1}`}
          href={`/work/${p.slug}/`}
          tabindex="-1"
          aria-hidden="true"
          data-reveal="y"
          style={`--d:${i % 2}`}
        >
          <Shot shot={s.shot} sizes="(min-width: 1024px) 50vw, 100vw" caption={`0${i + 1} — ${s.shot.caption}`} />
        </a>
      ))
    }
  </div>

  <div class="grid sys__body">
    <ProjectText project={p} class="sys__text" />
    {p.note && <p class="sys__note t-micro">{p.note}</p>}
  </div>
</article>

<style>
  .sys__head { row-gap: 16px; }
  .sys :global(.sys__meta) { grid-column: 1 / -1; }
  .sys__name {
    grid-column: 1 / -1;
    font-size: 20vw;
    color: var(--p-fg);
  }

  .sys__flow {
    position: relative;
    display: grid;
    gap: 0;
    margin: clamp(28px, 4vw, 56px) 0 0;
  }
  .sys__flow li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }
  .sys__n { color: var(--p-accent); }
  .sys__label {
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 650;
    font-size: 1.0625rem;
  }

  .sys__screens { margin-top: 28px; row-gap: 32px; }
  .sys__s { grid-column: 1 / -1; }

  .sys__body { margin-top: clamp(48px, 6vw, 88px); row-gap: 24px; }
  .sys :global(.sys__text) { grid-column: 1 / -1; }
  .sys__note { grid-column: 1 / -1; opacity: 0.8; }

  @media (min-width: 1024px) {
    .sys :global(.sys__meta) { grid-column: 1 / 7; }
    .sys__name { grid-column: 1 / -1; font-size: min(14vw, 16rem); line-height: 0.82; }

    /* the X axis: a single line with four stations */
    .sys__flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--g);
      padding-top: 22px;
    }
    .sys__flow::before {
      content: '';
      position: absolute;
      left: var(--m);
      right: var(--m);
      top: 0;
      height: 1px;
      background: var(--p-accent);
    }
    .sys__flow li {
      position: relative;
      border-top: 0;
      padding: 0;
    }
    .sys__flow li::before {
      content: '';
      position: absolute;
      left: 0;
      top: -26px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--p-accent);
      box-shadow: 0 0 0 5px var(--p-bg);
    }
    .sys__flow li:not(:last-child)::after {
      content: '→';
      margin-left: auto;
      padding-right: 18px;
      color: var(--p-accent);
    }

    .sys__screens {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-top: 56px;
      row-gap: 0;
      align-items: start;
    }
    .sys__s--1 { grid-column: 1 / 8; grid-row: 1; }
    .sys__s--2 { grid-column: 8 / 13; grid-row: 1; margin-top: 9vw; }
    .sys__s--3 { grid-column: 2 / 7; grid-row: 2; margin-top: 4vw; }
    .sys__s--4 { grid-column: 7 / 13; grid-row: 2; margin-top: 2vw; }

    .sys :global(.sys__text) {
      grid-column: 1 / 13;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--g);
      row-gap: 0;
    }
    .sys :global(.sys__text .ptext__tag) { grid-column: 1 / 5; grid-row: 1 / 4; }
    .sys :global(.sys__text .ptext__sum) { grid-column: 5 / 9; }
    .sys :global(.sys__text .ptext__meta) { grid-column: 9 / 13; grid-row: 1 / 3; margin: 0; }
    .sys :global(.sys__text .ptext__link) { grid-column: 5 / 9; margin-top: 22px; }
    .sys__note { grid-column: 5 / 13; }
  }
</style>
