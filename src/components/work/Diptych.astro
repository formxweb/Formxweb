---
/* 07 — Diptych: the same opening in two languages, then the route from A to B. */
import type { Project } from '../../data/projects';
import Shot from '../Shot.astro';
import ProjectMeta from './ProjectMeta.astro';
import ProjectText from './ProjectText.astro';

interface Props { project: Project }
const { project: p } = Astro.props;
const [tr, en, , fleet, , precision, booking] = p.shots;
const stops = ['Kalkış', 'Rota', 'Filo', 'Hizmet', 'Hassasiyet', 'Rezervasyon', 'Varış'];
const steps = [fleet, precision, booking].filter(Boolean);
---

<article
  class:list={['pj dip', p.theme.dark && 'on-dark']}
  id={`p-${p.slug}`}
  aria-labelledby={`p-${p.slug}-name`}
  style={`--p-bg:${p.theme.bg};--p-fg:${p.theme.fg};--p-accent:${p.theme.accent};--p-accent-ink:${p.theme.accentInk ?? p.theme.accent}`}
>
  <div class="grid dip__head">
    <ProjectMeta project={p} class="dip__meta" />
    <h3 class="pj-name pj-name--x dip__name" id={`p-${p.slug}-name`} lang={p.nameLang} data-reveal="mask">{p.name}</h3>
  </div>

  <div class="grid dip__pair">
    <a class="case-link dip__tr" href={`/work/${p.slug}/`} tabindex="-1" aria-hidden="true" data-reveal="z">
      <p class="dip__lang t-micro"><span>TR</span> Türkçe</p>
      <Shot shot={tr} sizes="(min-width: 1024px) 46vw, 100vw" />
    </a>
    <span class="dip__seam" aria-hidden="true"></span>
    <a class="case-link dip__en" href={`/work/${p.slug}/`} tabindex="-1" aria-hidden="true" data-reveal="z" style="--d:1">
      <p class="dip__lang t-micro" lang="en"><span>EN</span> English</p>
      <Shot shot={en} sizes="(min-width: 1024px) 46vw, 100vw" />
    </a>
  </div>

  <ol class="dip__route wrap" role="list" aria-label="Sitenin rotası: yedi durak">
    {
      stops.map((s, i) => (
        <li data-reveal="x" style={`--d:${i}`}>
          <span class="t-micro dip__n">{i === 0 ? 'A' : i === stops.length - 1 ? 'B' : `0${i + 1}`}</span>
          <span class="dip__stop">{s}</span>
        </li>
      ))
    }
  </ol>

  <div class="grid dip__steps">
    {
      steps.map((s, i) => (
        <a class={`case-link dip__s dip__s--${i + 1}`} href={`/work/${p.slug}/`} tabindex="-1" aria-hidden="true" data-reveal="y" style={`--d:${i}`}>
          <Shot shot={s} sizes="(min-width: 1024px) 31vw, 100vw" />
        </a>
      ))
    }
  </div>

  <div class="grid dip__body">
    <ProjectText project={p} class="dip__text" />
  </div>
</article>

<style>
  .dip__head { row-gap: 14px; }
  .dip :global(.dip__meta) { grid-column: 1 / -1; }
  .dip__name { grid-column: 1 / -1; font-size: 12.5vw; }

  .dip__pair { margin-top: clamp(28px, 4vw, 56px); row-gap: 28px; position: relative; }
  .dip__tr,
  .dip__en { grid-column: 1 / -1; display: grid; gap: 10px; }
  .dip__lang { display: flex; gap: 10px; opacity: 0.8; }
  .dip__lang span { color: var(--p-accent-ink); opacity: 1; }
  .dip__seam { display: none; }

  .dip__route {
    position: relative;
    display: grid;
    gap: 0;
    margin: clamp(48px, 7vw, 96px) 0 0;
  }
  .dip__route li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 11px 0 11px 20px;
    border-left: 1px solid var(--p-accent);
    position: relative;
  }
  .dip__route li::before {
    content: '';
    position: absolute;
    left: -4.5px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--p-bg);
    border: 1px solid var(--p-accent);
  }
  .dip__route li:first-child::before,
  .dip__route li:last-child::before { background: var(--p-accent); }
  .dip__n { color: var(--p-accent-ink); min-width: 1.8rem; }
  .dip__stop { font-family: var(--f-display); font-stretch: 112%; font-weight: 650; font-size: 1rem; }

  .dip__steps { margin-top: 32px; row-gap: 28px; align-items: start; }
  .dip__s { grid-column: 1 / -1; }

  .dip__body { margin-top: clamp(48px, 6vw, 88px); }
  .dip :global(.dip__text) { grid-column: 1 / -1; }

  @media (min-width: 640px) {
    .dip__route { grid-template-columns: repeat(7, minmax(0, 1fr)); padding-top: 26px; }
    .dip__route::before {
      content: '';
      position: absolute;
      left: var(--m);
      right: var(--m);
      top: 0;
      height: 1px;
      background: var(--p-accent);
    }
    .dip__route li { flex-direction: column; gap: 6px; padding: 0; border-left: 0; }
    .dip__route li::before { left: 0; top: -30px; margin-top: 0; }
    .dip__route li:last-child { align-items: flex-end; text-align: right; }
    .dip__route li:last-child::before { left: auto; right: 0; }
  }

  @media (min-width: 1024px) {
    .dip :global(.dip__meta) { grid-column: 1 / 9; }
    .dip__name { font-size: min(8.4vw, 9.5rem); }

    .dip__pair { column-gap: var(--g); }
    .dip__tr { grid-column: 1 / 7; }
    .dip__en { grid-column: 7 / 13; margin-top: 4vw; }
    .dip__seam {
      display: block;
      position: absolute;
      top: -20px;
      bottom: -20px;
      left: 50%;
      width: 1px;
      background: color-mix(in srgb, currentColor 30%, transparent);
    }

    .dip__steps { grid-template-columns: repeat(12, minmax(0, 1fr)); row-gap: 0; }
    .dip__s--1 { grid-column: 1 / 5; }
    .dip__s--2 { grid-column: 5 / 9; margin-top: 5vw; }
    .dip__s--3 { grid-column: 9 / 13; margin-top: 10vw; }

    .dip :global(.dip__text) {
      grid-column: 1 / 13;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--g);
      row-gap: 0;
    }
    .dip :global(.dip__text .ptext__tag) { grid-column: 1 / 5; grid-row: 1 / 4; }
    .dip :global(.dip__text .ptext__sum) { grid-column: 5 / 9; }
    .dip :global(.dip__text .ptext__meta) { grid-column: 9 / 13; grid-row: 1 / 3; margin: 0; }
    .dip :global(.dip__text .ptext__link) { grid-column: 5 / 9; margin-top: 22px; }
  }
</style>
