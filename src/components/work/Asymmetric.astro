---
/* 02 — Asymmetric: a narrow standing column against a bleeding image, prints crossing the edge. */
import type { Project } from '../../data/projects';
import Shot from '../Shot.astro';
import ProjectMeta from './ProjectMeta.astro';
import ProjectText from './ProjectText.astro';

interface Props { project: Project }
const { project: p } = Astro.props;
const [hero, b, c] = p.shots;
const sequence = ['KAP·AK', 'KAP', 'KAP·RİS', 'KAP·IŞ KAP·IŞ', 'KAP·AK OLSUN', 'KAP·I', 'KAP!'];
---

<article
  class:list={['pj asym', p.theme.dark && 'on-dark']}
  id={`p-${p.slug}`}
  aria-labelledby={`p-${p.slug}-name`}
  style={`--p-bg:${p.theme.bg};--p-fg:${p.theme.fg};--p-accent:${p.theme.accent};--p-accent-ink:${p.theme.accentInk ?? p.theme.accent}`}
>
  <div class="grid asym__grid">
    <div class="asym__side">
      <ProjectMeta project={p} />
      <h3 class="pj-name pj-name--y asym__name" id={`p-${p.slug}-name`} lang={p.nameLang} data-reveal="mask">
        <span>Cup</span><span>istan</span>
      </h3>
      <ProjectText project={p} class="asym__text" />
    </div>

    <a class="case-link asym__hero" href={`/work/${p.slug}/`} tabindex="-1" aria-hidden="true" data-reveal="z">
      <Shot shot={hero} sizes="(min-width: 1024px) 66vw, 100vw" />
    </a>

    <a class="case-link asym__b" href={`/work/${p.slug}/`} tabindex="-1" aria-hidden="true" data-reveal="y">
      <Shot shot={b} sizes="(min-width: 1024px) 40vw, 100vw" />
    </a>
    <a class="case-link asym__c" href={`/work/${p.slug}/`} tabindex="-1" aria-hidden="true" data-reveal="y" style="--d:2">
      <Shot shot={c} sizes="(min-width: 1024px) 26vw, 100vw" />
    </a>
  </div>

  <ol class="asym__seq wrap t-micro" role="list" aria-label="Kaydırma omurgası: KAP hecesinin yedi hali">
    {sequence.map((s, i) => <li data-reveal="x" style={`--d:${i}`}>{s}</li>)}
  </ol>
</article>

<style>
  .asym__grid { row-gap: 32px; align-items: start; }
  .asym__side { grid-column: 1 / -1; display: grid; gap: 22px; }
  .asym__name {
    display: flex;
    flex-direction: column;
    font-size: 27vw;
    gap: 0.1em;
    color: var(--p-accent);
    line-height: 0.84;
  }
  .asym__hero { grid-column: 1 / -1; margin-inline: calc(var(--m) * -1); }
  .asym__hero :global(.shot__cap) { padding-inline: var(--m); }
  .asym__b { grid-column: 1 / -1; }
  .asym__c { grid-column: 2 / -1; }

  .asym__seq {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    margin: clamp(40px, 6vw, 88px) 0 0;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .asym__seq li { display: flex; align-items: center; }
  .asym__seq li:not(:last-child)::after {
    content: '→';
    margin-inline: 14px;
    color: var(--p-accent-ink);
  }
  .asym__seq li:last-child { color: var(--p-accent-ink); }

  @media (min-width: 1024px) {
    .asym__grid { grid-template-rows: auto auto; }
    .asym__side {
      grid-column: 1 / 5;
      grid-row: 1 / 3;
      position: sticky;
      top: calc(var(--header-h) + 28px);
    }
    .asym__name { font-size: min(11.5vw, 13rem); }
    .asym__hero {
      grid-column: 5 / -1;
      grid-row: 1;
      margin-inline: 0 calc(var(--m) * -1);
    }
    .asym__hero :global(.shot__cap) { padding-inline: 0; }
    .asym__b {
      grid-column: 6 / 10;
      grid-row: 2;
      margin-top: -7vw;
      position: relative;
      z-index: 2;
      box-shadow: 0 0 0 10px var(--p-bg);
    }
    .asym__b :global(.shot__cap) { background: var(--p-bg); }
    .asym__c {
      grid-column: 10 / 13;
      grid-row: 2;
      margin-top: 5vw;
    }
  }
</style>
