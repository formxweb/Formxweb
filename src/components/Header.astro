---
import Wordmark from './Wordmark.astro';
import AxisMark from './AxisMark.astro';
import { acts, nav, site, whatsappHello, whatsappUrl } from '../data/site';

interface Props {
  /** Colour of whatever sits under the transparent header at the top of the page. */
  tone?: 'light' | 'dark';
  /** Label shown in the act indicator before any section reports itself. */
  act?: { no: string; name: string };
}
const { tone = 'light', act = { no: 'I', name: acts.I } } = Astro.props;

const path = Astro.url.pathname;
const isHome = path === '/';
/** Current page: exact match for the page itself, prefix match for its children (/work/x/ → İşler). */
const current = (href: string) => !href.includes('#') && path.startsWith(href);
/** Section id each nav item stands for on the home page (for the scroll-spy). */
const section = (home: string) => (home.startsWith('/#') ? home.slice(2) : undefined);
const wa = whatsappUrl(whatsappHello);
---

<header class="hd" data-hd data-tone={tone}>
  <a class="hd__brand" href="/" aria-label="VERYAXZ STUDIO — ana sayfa">
    <AxisMark size={16} class="hd__mark" />
    <Wordmark studio class="hd__word" />
  </a>

  <p class="hd__act t-micro" aria-hidden="true">
    <span class="hd__act-no" data-act-no>{act.no}</span>
    <span class="hd__act-name" data-act-name>{act.name}</span>
  </p>

  <nav class="hd__nav" aria-label="Ana menü">
    <ul role="list">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-section={isHome ? section(item.home) : undefined}
              aria-current={current(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="hd__wa t-micro" href={wa} target="_blank" rel="noopener" data-event="WhatsApp" data-event-place="header">
    <span class="hd__wa-dot" aria-hidden="true"></span>WhatsApp<span class="sr-only"> (yeni sekmede açılır)</span>
  </a>

  <a class="btn btn--axis hd__cta" href="/teklif/" data-event="Teklif" data-event-place="header">
    Proje başlat <span class="arr arr-x" aria-hidden="true">→</span>
  </a>

  <button class="hd__menu" type="button" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" data-menu-open>
    <span class="t-micro">Menü</span>
    <span class="hd__burger" aria-hidden="true"><i></i><i></i></span>
  </button>
</header>

<dialog id="menu" class="menu" aria-label="Menü" data-menu>
  <div class="menu__top">
    <Wordmark studio class="menu__word" />
    <button class="menu__close" type="button" data-menu-close>
      <span class="t-micro">Kapat</span>
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <nav aria-label="Mobil menü">
    <ol class="menu__list" role="list">
      <li>
        <a href="/" data-menu-link aria-current={isHome ? 'page' : undefined}>
          <span class="t-micro menu__no">00</span>
          <span class="menu__label">Ana sayfa</span>
        </a>
      </li>
      {
        nav.map((item, i) => (
          <li>
            <a href={item.href} data-menu-link aria-current={current(item.href) ? 'page' : undefined}>
              <span class="t-micro menu__no">0{i + 1}</span>
              <span class="menu__label">{item.label}</span>
              <span class="t-micro menu__en" lang="en">{item.en}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot">
    <a class="btn btn--axis" href="/teklif/" data-menu-link data-event="Teklif" data-event-place="menu">
      Proje başlat <span class="arr arr-x" aria-hidden="true">→</span>
    </a>
    <ul class="menu__contact t-micro" role="list">
      <li><a href={wa} rel="noopener" target="_blank" data-event="WhatsApp" data-event-place="menu">WhatsApp ↗</a></li>
      <li><a href={`tel:${site.contact.phoneHref}`} class="menu__tel" data-event="Telefon" data-event-place="menu">{site.contact.phoneDisplay}</a></li>
      <li><a href={site.contact.instagram} rel="noopener" target="_blank" data-event="Instagram" data-event-place="menu">Instagram ↗</a></li>
    </ul>
  </div>
</dialog>

<style>
  .hd {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--g);
    align-items: center;
    padding-inline: var(--m);
    color: var(--ink);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      transform var(--t2) var(--ease),
      background-color var(--t2) linear,
      border-color var(--t2) linear;
  }
  .hd[data-scrolled] {
    background: rgb(232 228 218 / 0.95);
    border-bottom-color: var(--line);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .hd[data-scrolled] {
      background: rgb(232 228 218 / 0.93);
      backdrop-filter: blur(12px) saturate(1.2);
      -webkit-backdrop-filter: blur(12px) saturate(1.2);
    }
  }
  .hd[data-hidden] { transform: translateY(-100%); }
  .hd[data-tone='dark']:not([data-scrolled]) { color: var(--paper); }
  .hd[data-tone='dark']:not([data-scrolled]) .hd__mark,
  .hd[data-tone='dark']:not([data-scrolled]) .hd__act-no { color: var(--axis-light); }
  .hd[data-tone='dark']:not([data-scrolled]) :global(.axis-letter) { color: var(--axis-light); }
  .hd[data-tone='dark']:not([data-scrolled]) :focus-visible { outline-color: var(--axis-light); }
  .hd[data-tone='dark']:not([data-scrolled]) .hd__wa { border-color: rgb(232 228 218 / 0.4); }

  .hd__brand {
    grid-column: 1 / span 3;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    min-height: 44px;
  }
  .hd__mark { color: var(--axis); }
  .hd__brand :global(.hd__word) { font-size: 0.9375rem; }

  .hd__act,
  .hd__nav,
  .hd__wa,
  .hd__cta { display: none; }

  .hd__menu {
    grid-column: -2 / -1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
  }
  .hd__burger {
    display: grid;
    gap: 5px;
    width: 22px;
  }
  .hd__burger i {
    display: block;
    height: 1.5px;
    background: currentColor;
  }
  .hd__burger i:last-child { width: 60%; justify-self: end; }

  @media (min-width: 1024px) {
    .hd {
      display: flex;
      gap: clamp(14px, 1.8vw, 28px);
    }
    .hd__brand { margin-right: auto; }
    .hd__act {
      display: flex;
      gap: 10px;
      min-width: 9rem;
    }
    .hd__act-no { color: var(--axis); min-width: 2.2em; }
    .hd__nav {
      display: block;
      margin-left: auto;
    }
    .hd__nav ul {
      display: flex;
      gap: clamp(14px, 1.7vw, 26px);
      margin: 0;
    }
    .hd__nav a {
      position: relative;
      display: inline-block;
      padding: 10px 0;
      font-family: var(--f-display);
      font-stretch: 112%;
      font-weight: 600;
      font-size: 0.875rem;
      letter-spacing: 0;
    }
    .hd__nav a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 4px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform var(--t2) var(--ease);
    }
    .hd__nav a:hover::after,
    .hd__nav a[aria-current]::after {
      transform: scaleX(1);
      transform-origin: left;
    }
    .hd__wa {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      padding: 0 12px;
      border: 1px solid var(--line-2);
      transition: border-color var(--t1) linear, color var(--t1) linear;
    }
    .hd__wa:hover { border-color: currentColor; }
    .hd__wa-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #25d366;
      box-shadow: 0 0 0 2px rgb(37 211 102 / 0.22);
    }
    .hd__cta {
      display: inline-flex;
      min-height: 40px;
      font-size: 0.75rem;
    }
    .hd__menu { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hd__act { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1099px) {
    .hd__wa { display: none; }
  }

  /* --- mobile menu ------------------------------------------------------- */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--m) max(24px, env(safe-area-inset-bottom));
    border: 0;
    background: var(--paper);
    color: var(--ink);
    display: none;
    flex-direction: column;
    overflow-y: auto;
  }
  .menu[open] { display: flex; }
  .menu::backdrop { background: rgb(18 18 17 / 0.4); }
  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: none;
    height: var(--header-h);
    border-bottom: 1px solid var(--line);
  }
  .menu__top :global(.menu__word) { font-size: 0.9375rem; }
  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    background: none;
    border: 0;
    padding: 0;
    font-size: 1.5rem;
    line-height: 1;
  }
  .menu nav { flex: 1; display: flex; }
  .menu__list {
    margin: 0;
    padding: 12px 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .menu__list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .menu__list a[aria-current] .menu__label { color: var(--axis); }
  .menu__label {
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: min(8.4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .menu__no { color: var(--axis); }
  .menu__en { color: var(--mute); }
  .menu__foot {
    display: grid;
    gap: 18px;
    flex: none;
    padding-top: 18px;
  }
  .menu__foot .btn { width: 100%; }
  .menu__contact {
    display: flex;
    justify-content: space-between;
    margin: 0;
  }
  .menu__contact a {
    display: inline-block;
    padding: 10px 0;
  }
  .menu__contact .menu__tel { font-family: var(--f-text); font-size: 0.875rem; font-weight: 600; letter-spacing: 0; }
  @media (max-height: 560px) {
    .menu__label { font-size: 1.75rem; }
    .menu__list a { padding: 8px 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] { animation: menu-in var(--t2) var(--ease); }
    .menu[open] .menu__list li {
      animation: menu-item var(--t3) var(--ease) both;
      animation-delay: calc(var(--n, 0) * 40ms);
    }
    .menu[open] .menu__list li:nth-child(2) { --n: 1; }
    .menu[open] .menu__list li:nth-child(3) { --n: 2; }
    .menu[open] .menu__list li:nth-child(4) { --n: 3; }
    .menu[open] .menu__list li:nth-child(5) { --n: 4; }
    .menu[open] .menu__list li:nth-child(6) { --n: 5; }
  }
  @keyframes menu-in {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes menu-item {
    from { transform: translateY(18px); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
</style>
