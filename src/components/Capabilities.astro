---
import Rail from './Rail.astro';
import { getProject } from '../data/projects';

const proof = (slugs: string[]) =>
  slugs.map((s) => getProject(s)).filter((p): p is NonNullable<typeof p> => Boolean(p));

const services = [
  {
    n: '01',
    title: 'Custom website design',
    text: 'Markanın karakterine göre geliştirilen özel dijital deneyimler.',
    value: 'Şablon yok. Konsept, markanın kendi adından, ürününden ya da hikâyesinden çıkıyor; tipografi, renk ve hareket o konsepte göre kuruluyor.',
    gets: ['Üç ayrı sanat yönetimi yaklaşımı', 'Markaya özel tipografi ve hareket sistemi', 'Sıfırdan yazılan, hızlı kod'],
    proof: proof(['bogazdayiz', 'cupistan', 'marmara-blue']),
  },
  {
    n: '02',
    title: 'Business websites',
    text: 'İşletmenin güvenilirliğini ve hizmetlerini güçlü biçimde sunan siteler.',
    value: 'Ziyaretçinin aradığı her şey ilk bakışta: ne yaptığınız, nerede olduğunuz, ne zaman açık olduğunuz ve size nasıl ulaşacağı.',
    gets: ['Hizmetler, saatler ve konum net', 'Yerel SEO ve yapılandırılmış veri', 'WhatsApp ve telefona tek dokunuş'],
    proof: proof(['swiss-fit-club', 'la-joie']),
  },
  {
    n: '03',
    title: 'E‑commerce',
    text: 'Ürün keşfinden satın alma akışına kadar düşünülmüş satış deneyimleri.',
    value: 'Vitrinden kargo takibine kadar tek bir sistem: stok, varyant, güvenli ödeme, sipariş takibi ve yönetim paneli.',
    gets: ['Renk, beden ve stok yönetimi', 'Shopier veya iyzico ile güvenli ödeme', 'Sipariş takibi ve yönetim paneli'],
    proof: proof(['motorcu-chopper']),
  },
  {
    n: '04',
    title: 'Landing pages',
    text: 'Kampanyalar ve müşteri kazanımı için hedef odaklı sayfalar.',
    value: 'Tek hedef, tek eylem. Her bölüm ziyaretçiyi aynı noktaya taşıyor: talep, rezervasyon ya da satın alma.',
    gets: ['Kampanya hikâyesine göre kurgu', 'Tek ve net bir eylem çağrısı', 'Hızlı yükleme, ölçüme hazır yapı'],
    proof: proof(['marmara-blue']),
  },
  {
    n: '05',
    title: 'Website redesign',
    text: 'Mevcut dijital varlığı daha tutarlı, modern ve işlevsel hale getirme.',
    value: 'Elinizdeki içeriği, menüyü ve bilgiyi koruyarak daha tutarlı bir görsel dil, daha hızlı bir altyapı ve mobilde daha kolay bir kullanım.',
    gets: ['Mevcut içerik ve verinin korunması', 'Tutarlı yeni bir görsel dil', 'Mobilde daha hızlı ve kullanışlı'],
    proof: proof(['la-joie', 'swiss-fit-club']),
  },
];

const flow = ['Keşif', 'Ürün', 'Seçenek', 'Sepet', 'Ödeme', 'Takip'];
---

<section class="cap" id="capabilities" data-act="III" data-act-name="Capabilities" aria-labelledby="cap-title">
  <Rail act="Act III" title="Capabilities" axis="X — her hizmet kendi amacına göre" end="05 hizmet" />

  <div class="grid cap__intro">
    <h2 class="cap__title" id="cap-title" lang="en" data-reveal="mask">Capabilities</h2>
    <p class="cap__lead t-lead" data-reveal="y">
      Hizmet listesi değil; her biri ayrı bir amaç. Hepsinde aynı temel: mobil öncelikli yapı, hızlı yükleme,
      erişilebilirlik ve arama motorlarına hazır kod.
    </p>
  </div>

  <ol class="cap__list" role="list">
    {
      services.map((s, i) => (
        <li class={`svc svc--${i + 1}`}>
          <article class="grid svc__grid" aria-labelledby={`svc-${s.n}`}>
            <p class="svc__n t-micro" data-reveal="x">{s.n} /</p>
            <h3 class="svc__title" id={`svc-${s.n}`} lang="en" data-reveal="mask">{s.title}</h3>

            <div class="svc__fig" aria-hidden="true" data-reveal="draw">
              {i === 0 && (
                <svg viewBox="0 0 320 240" class="fig">
                  <g class="ln">
                    <path pathLength="1" d="M16 88H304" />
                    <path pathLength="1" d="M16 116H304" class="ax" />
                    <path pathLength="1" d="M16 180H304" />
                    <path d="M16 210H304" stroke-dasharray="3 4" data-nd />
                  </g>
                  <text x="18" y="180" class="spec">Aa</text>
                  <g class="lbl">
                    <text x="304" y="82" text-anchor="end">CAP</text>
                    <text x="304" y="110" text-anchor="end" class="ax-t">X-HEIGHT</text>
                    <text x="304" y="174" text-anchor="end">BASELINE</text>
                    <text x="304" y="204" text-anchor="end">DESCENDER</text>
                  </g>
                  <g class="ln">
                    <path pathLength="1" d="M18 228V36" />
                    <circle cx="18" cy="180" r="3.5" class="dot" />
                  </g>
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 320 240" class="fig">
                  <g class="ln">
                    <rect x="110" y="12" width="100" height="30" pathLength="1" />
                    <path pathLength="1" d="M160 42V68M42 68H278M42 68V88M122 68V88M200 68V88M278 68V88" />
                    <rect x="10" y="88" width="64" height="28" pathLength="1" />
                    <rect x="90" y="88" width="64" height="28" pathLength="1" />
                    <rect x="168" y="88" width="64" height="28" pathLength="1" />
                    <rect x="246" y="88" width="64" height="28" pathLength="1" class="ax" />
                    <path pathLength="1" d="M22 132H62M22 146H56M22 160H62" />
                    <path pathLength="1" d="M278 116V214M278 146H262M278 180H262M278 214H262" class="ax" />
                  </g>
                  <g class="lbl">
                    <text x="160" y="31" text-anchor="middle">ANA SAYFA</text>
                    <text x="42" y="106" text-anchor="middle">HİZMET</text>
                    <text x="122" y="106" text-anchor="middle">HAKKINDA</text>
                    <text x="200" y="106" text-anchor="middle">SAATLER</text>
                    <text x="278" y="106" text-anchor="middle" class="ax-t">İLETİŞİM</text>
                    <text x="256" y="149" text-anchor="end" class="ax-t">WHATSAPP</text>
                    <text x="256" y="183" text-anchor="end" class="ax-t">HARİTA</text>
                    <text x="256" y="217" text-anchor="end" class="ax-t">TELEFON</text>
                  </g>
                </svg>
              )}
              {i === 2 && (
                <ol class="flow t-micro" role="list">
                  {flow.map((f, k) => (
                    <li style={`--k:${k}`}>
                      <span class="flow__n">0{k + 1}</span>
                      <span class="flow__t">{f}</span>
                    </li>
                  ))}
                </ol>
              )}
              {i === 3 && (
                <svg viewBox="0 0 180 320" class="fig fig--tall">
                  <g class="ln">
                    <rect x="20" y="8" width="140" height="304" pathLength="1" />
                    <path pathLength="1" d="M34 30H128M34 44H100" />
                    <rect x="34" y="58" width="112" height="54" pathLength="1" />
                    <path pathLength="1" d="M34 128H146M34 140H130M34 152H140" />
                    <rect x="34" y="168" width="52" height="40" pathLength="1" />
                    <rect x="94" y="168" width="52" height="40" pathLength="1" />
                    <path d="M90 112V246M60 208L84 248M120 208L96 248" stroke-dasharray="2 3" data-nd class="ax" />
                    <circle cx="90" cy="266" r="34" class="ax" stroke-dasharray="2 3" data-nd />
                    <circle cx="90" cy="266" r="22" pathLength="1" class="ax" />
                  </g>
                  <rect x="62" y="256" width="56" height="20" class="cta-fill" />
                </svg>
              )}
              {i === 4 && (
                <svg viewBox="0 0 320 220" class="fig">
                  <g class="ln old">
                    <rect x="22" y="22" width="120" height="34" transform="rotate(-2 82 39)" />
                    <rect x="34" y="70" width="74" height="60" transform="rotate(1.5 71 100)" />
                    <rect x="116" y="76" width="44" height="40" transform="rotate(-3 138 96)" />
                    <rect x="26" y="142" width="128" height="22" transform="rotate(1 90 153)" />
                  </g>
                  <g class="ln">
                    <rect x="176" y="22" width="128" height="34" pathLength="1" />
                    <rect x="176" y="68" width="60" height="62" pathLength="1" />
                    <rect x="244" y="68" width="60" height="62" pathLength="1" />
                    <rect x="176" y="142" width="128" height="22" pathLength="1" class="ax" />
                    <path pathLength="1" d="M22 196H304M292 190L304 196L292 202" class="ax" />
                  </g>
                  <g class="lbl">
                    <text x="22" y="186">ÖNCE</text>
                    <text x="176" y="186" class="ax-t">SONRA</text>
                  </g>
                </svg>
              )}
            </div>

            <div class="svc__copy">
              <p class="svc__text t-lead" data-reveal="y">{s.text}</p>
              <p class="svc__value t-mute" data-reveal="y" style="--d:1">{s.value}</p>
            </div>

            <ul class="svc__gets" role="list" data-reveal="y" style="--d:2">
              {s.gets.map((g) => <li>{g}</li>)}
            </ul>

            <p class="svc__proof t-micro" data-reveal="y" style="--d:3">
              <span class="t-mute">Örnek</span>
              {s.proof.map((p) => (
                <a href={`/work/${p.slug}/`} lang={p.nameLang}>
                  {p.name}
                  <span aria-hidden="true"> ↗</span>
                </a>
              ))}
            </p>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .cap { padding-top: clamp(56px, 8vw, 128px); overflow: clip; }
  .cap__intro { row-gap: 22px; padding-block: clamp(28px, 4vw, 56px) clamp(40px, 6vw, 96px); align-items: end; }
  .cap__title {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--f-display);
    font-stretch: 75%;
    font-weight: 800;
    font-size: clamp(3.5rem, 1rem + 13.5vw, 13rem);
    line-height: 0.88;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .cap__lead { grid-column: 1 / -1; max-width: 40ch; }

  .cap__list { margin: 0; }
  .svc { border-top: 1px solid var(--line-2); }
  .svc:last-child { border-bottom: 1px solid var(--line-2); }
  .svc__grid { padding-block: clamp(36px, 5vw, 80px); row-gap: 22px; align-items: start; }
  .svc__n { grid-column: 1 / -1; color: var(--axis); }
  .svc__title {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.9;
  }
  .svc__fig { grid-column: 1 / -1; color: var(--ink); }
  .svc__copy { grid-column: 1 / -1; display: grid; gap: 12px; max-width: 52ch; }
  .svc__value { font-size: var(--fs-small); line-height: 1.6; }
  .svc__gets {
    grid-column: 1 / -1;
    margin: 0;
    display: grid;
    gap: 0;
  }
  .svc__gets li {
    display: flex;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .svc__gets li::before { content: '+'; color: var(--axis); font-family: var(--f-mono); }
  .svc__proof {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
  }
  .svc__proof a { padding-block: 6px; border-bottom: 1px solid currentColor; transition: color var(--t1) linear; }
  .svc__proof a:hover { color: var(--axis); }

  /* per-service type: each title takes the width its purpose needs */
  .svc--1 .svc__title { font-stretch: 125%; letter-spacing: -0.04em; font-size: clamp(2.4rem, 0.8rem + 6.6vw, 7.5rem); }
  .svc--2 .svc__title { font-stretch: 100%; letter-spacing: -0.025em; font-size: clamp(2.4rem, 1rem + 5.2vw, 6rem); }
  .svc--3 .svc__title { font-stretch: 125%; letter-spacing: -0.045em; font-size: clamp(2.4rem, 0.6rem + 7.6vw, 9.5rem); white-space: nowrap; }
  .svc--4 .svc__title { font-stretch: 75%; letter-spacing: -0.005em; font-size: clamp(3.2rem, 1rem + 10vw, 11rem); line-height: 0.86; }
  .svc--5 .svc__title { font-stretch: 112%; letter-spacing: -0.03em; font-size: clamp(2.4rem, 1rem + 5.6vw, 6.5rem); }

  /* figures ----------------------------------------------------------------- */
  .fig { width: 100%; max-width: 440px; height: auto; overflow: visible; }
  .fig--tall { max-width: 200px; }
  .fig .ln path,
  .fig .ln rect,
  .fig .ln circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .fig .ln .ax { stroke: var(--axis); }
  .fig .ln.old rect { stroke: var(--mute); stroke-dasharray: 4 4; }
  .fig .dot { fill: var(--axis) !important; stroke: none !important; }
  .fig .cta-fill { fill: var(--axis); }
  .fig .spec {
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 124px;
    letter-spacing: -4px;
    fill: var(--ink);
  }
  .fig .lbl text {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    fill: var(--mute);
  }
  .fig .lbl .ax-t { fill: var(--axis); }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal='draw'] .ln:not(.old) > :not([data-nd]) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1.4s var(--ease);
    }
    :global(.js) [data-reveal='draw'].is-in .ln > * { stroke-dashoffset: 0; }
  }

  /* e-commerce flow: the X axis itself ---------------------------------------- */
  .flow {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
  }
  .flow li {
    position: relative;
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 12px 0 12px 22px;
    border-left: 1px solid var(--axis);
  }
  .flow li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--axis);
  }
  .flow li:last-child::before { background: var(--axis); }
  .flow__n { color: var(--axis); }
  .flow__t {
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (min-width: 640px) {
    .cap__lead { grid-column: 3 / -1; }
  }

  @media (min-width: 1024px) {
    .cap__title { grid-column: 1 / -1; font-size: min(13.6vw, 15rem); }
    .cap__lead { grid-column: 8 / 13; }

    .svc__n { grid-column: 1 / 2; padding-top: 0.6em; }
    .svc__copy { max-width: none; }

    /* 01 — title spans, specimen on the right */
    .svc--1 .svc__title { grid-column: 2 / 9; grid-row: 1; }
    .svc--1 .svc__fig { grid-column: 9 / 13; grid-row: 1 / 3; justify-self: end; width: 100%; }
    .svc--1 .svc__copy { grid-column: 2 / 6; }
    .svc--1 .svc__gets { grid-column: 6 / 9; }
    .svc--1 .svc__proof { grid-column: 2 / 9; }

    /* 02 — structure first: sitemap on the left */
    .svc--2 .svc__fig { grid-column: 1 / 5; grid-row: 1 / 4; }
    .svc--2 .svc__n { grid-column: 6 / 7; grid-row: 1; }
    .svc--2 .svc__title { grid-column: 6 / 13; grid-row: 1; padding-left: 3.2rem; }
    .svc--2 .svc__copy { grid-column: 6 / 10; }
    .svc--2 .svc__gets { grid-column: 10 / 13; }
    .svc--2 .svc__proof { grid-column: 6 / 13; }

    /* 03 — the flow runs the full width */
    .svc--3 .svc__title { grid-column: 2 / 13; }
    .svc--3 .svc__fig { grid-column: 1 / 13; margin-block: 18px 10px; }
    .svc--3 .svc__copy { grid-column: 2 / 6; }
    .svc--3 .svc__gets { grid-column: 7 / 10; }
    .svc--3 .svc__proof { grid-column: 10 / 13; align-self: end; justify-content: flex-end; }
    .flow { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: var(--g); padding-top: 26px; }
    .flow::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 1px;
      background: var(--axis);
    }
    .flow li { border-left: 0; padding: 0; flex-direction: column; gap: 6px; }
    .flow li::before { left: 0; top: -30px; margin-top: 0; }
    .flow__t { font-size: clamp(1.125rem, 0.6rem + 1vw, 1.625rem); }

    /* 04 — one tall standing word, one tall page */
    .svc--4 .svc__title { grid-column: 2 / 8; grid-row: 1 / 3; }
    .svc--4 .svc__copy { grid-column: 8 / 11; grid-row: 1; }
    .svc--4 .svc__gets { grid-column: 8 / 11; grid-row: 2; }
    .svc--4 .svc__fig { grid-column: 11 / 13; grid-row: 1 / 4; justify-self: end; }
    .svc--4 .svc__proof { grid-column: 2 / 8; }

    /* 05 — before and after side by side */
    .svc--5 .svc__fig { grid-column: 2 / 7; grid-row: 2 / 4; }
    .svc--5 .svc__title { grid-column: 2 / 13; grid-row: 1; }
    .svc--5 .svc__copy { grid-column: 8 / 12; grid-row: 2; }
    .svc--5 .svc__gets { grid-column: 8 / 12; grid-row: 3; }
    .svc--5 .svc__proof { grid-column: 8 / 13; grid-row: 4; }
  }
</style>
