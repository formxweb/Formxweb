---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/ui/PageHead.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { site } from '../../data/site';
import { projects } from '../../data/projects';
import { services } from '../../data/services';
import { axes, principles, steps } from '../../data/process';
import { countWord } from '../../lib/text';

const n = countWord(projects.length);
const sectors = [...new Set(projects.map((p) => p.category))];
const founder = site.studio.founder;
const facts = [
  { k: 'Şehir', v: site.studio.city },
  { k: 'Hizmet bölgesi', v: site.studio.serviceArea },
  { k: 'Çalışma saatleri', v: site.studio.hours },
].filter((f) => f.v);

const nots = [
  { t: 'Şablon satmıyoruz.', d: 'Her proje kendi konseptinden, kendi tipografisinden ve renginden doğuyor.' },
  { t: 'Stok görsel kullanmıyoruz.', d: 'Fotoğraf yoksa site fotoğrafsız da eksiksiz çalışacak şekilde tasarlanıyor.' },
  { t: 'Uydurma bilgi yayınlamıyoruz.', d: 'Fiyat, saat, adres ve menü yalnızca markanın kendi kaynağından geliyor.' },
  { t: 'Sahte onay ekranı yapmıyoruz.', d: 'Bir form ya da rezervasyon gerçekten gitmediyse ekran “gönderildi” demiyor.' },
  { t: 'Sıralama garantisi vermiyoruz.', d: 'Teknik SEO temelini eksiksiz kuruyoruz; sıralama sözü vermiyoruz.' },
];
---

<Base
  title="Stüdyo — Strateji, Tasarım ve Geliştirme"
  description="VERYAXZ STUDIO; strateji, tasarım ve geliştirmeyi tek bir bütün olarak ele alan bir web tasarım ve geliştirme stüdyosu. Nasıl çalıştığımız, neye inandığımız ve neyi yapmadığımız."
  pageType="AboutPage"
  breadcrumbs={[{ name: 'Stüdyo', path: '/studyo/' }]}
  act={{ no: 'P', name: 'Stüdyo' }}
>
  <PageHead
    crumbs={[{ name: 'Stüdyo' }]}
    eyebrow="Studio — X · Y · Z"
    title="Dijitalde bir imza, üç eksenin kesiştiği yerde."
    lead={`VERYAXZ STUDIO; markalar için özel web siteleri, e-ticaret ve kampanya sayfaları tasarlayıp kodlayan bir stüdyo. Strateji, tasarım ve geliştirme ayrı ekiplerde değil, tek bir masada.`}
  />

  <section class="grid st-name" aria-labelledby="st-name">
    <h2 class="t-micro st-label" id="st-name">Adın içindeki üç eksen</h2>
    <p class="st-word">
      <span aria-hidden="true">VER<b>Y</b>A<b>XZ</b></span>
      <span class="sr-only">VERYAXZ: Y, X ve Z harfleri vurgulanmış</span>
    </p>
    <dl class="st-axes">
      {
        axes.map((a) => (
          <div>
            <dt><span class="st-k">{a.k}</span> {a.name} <span class="t-micro t-mute" lang="en">{a.en}</span></dt>
            <dd>{a.text}</dd>
          </div>
        ))
      }
      <div class="st-p">
        <dt><span class="st-k">P</span> Markanız</dt>
        <dd>Üçünün kesiştiği tek nokta. Başka bir markanın kullanamayacağı bir konum. Her projeye bu noktayı bulmakla başlıyoruz.</dd>
      </div>
    </dl>
  </section>

  <section class="grid st-work" aria-labelledby="st-work">
    <h2 class="st-h" id="st-work">Şimdiye kadar</h2>
    <div class="st-work__body">
      <p class="st-lead">
        {n.charAt(0).toLocaleUpperCase('tr') + n.slice(1)} proje, {n} ayrı sanat yönetimi: {sectors.map((s) => s.toLocaleLowerCase('tr')).join(', ')}.
        Her birinin konsepti markanın kendi adından, ürününden ya da hikâyesinden çıktı.
      </p>
      <ul class="st-projects" role="list">
        {
          projects.map((p) => (
            <li>
              <a href={`/work/${p.slug}/`} style={`--c:${p.theme.dark ? p.theme.bg : (p.theme.accentInk ?? p.theme.accent)}`}>
                <span class="st-dot" aria-hidden="true" />
                <span class="st-pn" lang={p.nameLang}>{p.name}</span>
                <span class="t-micro t-mute">{p.category}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="st-process" aria-labelledby="st-process">
    <div class="grid">
      <h2 class="st-h" id="st-process">Birlikte çalışmak</h2>
      <p class="st-process__lead t-mute">Her adımın sonunda sizin onayınız var. Kimin ne yaptığı baştan belli.</p>
    </div>
    <div class="wrap st-table-wrap" role="region" aria-label="Çalışma adımları tablosu" tabindex="0">
      <table class="st-table">
        <thead>
          <tr>
            <th scope="col" class="t-micro">Adım</th>
            <th scope="col" class="t-micro">Ne yapıyoruz</th>
            <th scope="col" class="t-micro">Sizden</th>
            <th scope="col" class="t-micro">Sonunda elinizde</th>
          </tr>
        </thead>
        <tbody>
          {
            steps.map((s, i) => (
              <tr>
                <th scope="row"><span class="t-micro">0{i + 1}</span> {s.t}</th>
                <td>{s.d}</td>
                <td>{s.you}</td>
                <td>{s.out}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="grid st-principles" aria-labelledby="st-principles">
    <h2 class="st-h" id="st-principles">Her projede</h2>
    <ul class="st-plist" role="list">
      {
        principles.map((p, i) => (
          <li data-reveal="y" style={`--d:${i % 2}`}>
            <span class="t-micro">0{i + 1}</span>
            <p class="st-pt">{p.t}</p>
            <p class="st-pd t-mute">{p.d}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="grid st-nots on-dark" aria-labelledby="st-nots">
    <h2 class="st-h" id="st-nots">Yapmadıklarımız</h2>
    <ul class="st-nlist" role="list">
      {
        nots.map((x) => (
          <li>
            <p class="st-nt">{x.t}</p>
            <p class="st-nd">{x.d}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    (founder.name || facts.length > 0) && (
      <section class="grid st-facts" aria-labelledby="st-facts">
        <h2 class="t-micro st-label" id="st-facts">Künye</h2>
        <dl class="st-fl">
          {founder.name && (<div><dt class="t-micro">{founder.role || 'Kurucu'}</dt><dd>{founder.name}</dd></div>)}
          {facts.map((f) => (<div><dt class="t-micro">{f.k}</dt><dd>{f.v}</dd></div>))}
        </dl>
      </section>
    )
  }

  <section class="grid st-svc" aria-labelledby="st-svc">
    <h2 class="t-micro st-label" id="st-svc">Hizmetler</h2>
    <ul role="list" class="st-slist">
      {services.map((s) => <li><a href={`/hizmetler/${s.slug}/`}><span class="t-micro">{s.no}</span> {s.tr} <span aria-hidden="true">→</span></a></li>)}
    </ul>
  </section>

  <CtaBand place="studyo" />
</Base>

<style>
  .st-label { grid-column: 1 / -1; color: var(--axis); margin-bottom: 18px; }
  .st-h {
    grid-column: 1 / -1;
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 750;
    font-size: var(--fs-m);
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 16ch;
  }

  .st-name { padding-block: clamp(40px, 5vw, 80px); border-top: 1px solid var(--line-2); row-gap: 24px; }
  .st-word {
    grid-column: 1 / -1;
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: min(14.5vw, 13rem);
    letter-spacing: -0.045em;
    line-height: 0.85;
  }
  .st-word b { font-weight: inherit; color: var(--axis); }
  .st-axes { grid-column: 1 / -1; display: grid; gap: 0; margin: 0; }
  .st-axes > div { padding: 16px 0; border-top: 1px solid var(--line); }
  .st-axes dt { font-family: var(--f-display); font-stretch: 112%; font-weight: 700; font-size: 1.25rem; }
  .st-axes dd { margin: 6px 0 0; color: var(--ink-2); max-width: 46ch; }
  .st-k { display: inline-block; min-width: 1.6em; color: var(--axis); }
  .st-p dt .st-k { color: var(--ink); }
  .st-axes > .st-p { background: var(--paper-2); padding-inline: 14px; }

  .st-work { row-gap: 24px; padding-block: clamp(48px, 6vw, 96px); }
  .st-work__body { grid-column: 1 / -1; display: grid; gap: 28px; }
  .st-lead { font-size: var(--fs-lead); line-height: 1.4; max-width: 44ch; }
  .st-projects { margin: 0; display: grid; }
  .st-projects a { display: grid; grid-template-columns: 22px 1fr auto; align-items: baseline; gap: 10px; padding: 12px 0; border-top: 1px solid var(--line); }
  .st-projects a:hover .st-pn { color: var(--axis); }
  .st-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); align-self: center; box-shadow: 0 0 0 1px rgb(18 18 17 / 0.2); }
  .st-pn { font-family: var(--f-display); font-stretch: 112%; font-weight: 750; text-transform: uppercase; }

  .st-process { padding-block: clamp(48px, 6vw, 96px); background: var(--paper-2); }
  .st-process .grid { row-gap: 12px; margin-bottom: 28px; }
  .st-process__lead { grid-column: 1 / -1; font-size: var(--fs-small); }
  .st-table-wrap { position: relative; overflow-x: auto; }
  .st-table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: var(--fs-small); }
  .st-table th, .st-table td { text-align: left; vertical-align: top; padding: 16px 16px 16px 0; border-top: 1px solid var(--line); }
  .st-table thead th { font-weight: 400; color: var(--mute); border-top: 0; padding-bottom: 10px; }
  .st-table tbody th { font-family: var(--f-display); font-stretch: 112%; font-weight: 700; font-size: 1.0625rem; white-space: nowrap; }
  .st-table tbody th .t-micro { color: var(--axis); margin-right: 6px; }
  .st-table td:nth-child(3) { color: var(--ink-2); }
  .st-table td:nth-child(4) { font-weight: 600; }

  .st-principles { row-gap: 24px; padding-block: clamp(56px, 7vw, 112px); }
  .st-plist { grid-column: 1 / -1; margin: 0; display: grid; gap: 28px var(--g); }
  .st-plist li { display: grid; gap: 8px; padding-top: 16px; border-top: 1px solid var(--line-2); }
  .st-plist .t-micro { color: var(--axis); }
  .st-pt { font-family: var(--f-display); font-stretch: 112%; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.015em; }
  .st-pd { font-size: var(--fs-small); max-width: 44ch; }

  .st-nots { row-gap: 24px; padding-block: clamp(56px, 7vw, 112px); background: var(--ink); color: var(--paper); }
  .st-nlist { grid-column: 1 / -1; margin: 0; display: grid; }
  .st-nlist li { display: grid; gap: 4px; padding: 16px 0; border-top: 1px solid rgb(232 228 218 / 0.2); }
  .st-nt { font-family: var(--f-display); font-stretch: 112%; font-weight: 750; font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); letter-spacing: -0.02em; }
  .st-nt::before { content: '×'; display: inline-block; width: 1.2em; color: var(--axis-light); }
  .st-nd { color: rgb(232 228 218 / 0.78); font-size: var(--fs-small); padding-left: 1.2em; max-width: 52ch; }

  .st-facts, .st-svc { row-gap: 8px; padding-block: clamp(40px, 5vw, 72px) 0; }
  .st-fl { grid-column: 1 / -1; display: grid; gap: 14px; margin: 0; }
  .st-fl dd { margin: 4px 0 0; font-weight: 600; }
  .st-slist { grid-column: 1 / -1; margin: 0 0 clamp(56px, 7vw, 112px); display: grid; }
  .st-slist a { display: flex; gap: 12px; align-items: baseline; padding: 12px 0; border-top: 1px solid var(--line); font-weight: 600; }
  .st-slist a:hover { color: var(--axis); }
  .st-slist .t-micro { color: var(--axis); }

  @media (min-width: 1024px) {
    .st-axes { grid-template-columns: repeat(4, 1fr); column-gap: var(--g); }
    .st-work .st-h, .st-principles .st-h, .st-nots .st-h { grid-column: 1 / 5; align-self: start; }
    .st-work__body { grid-column: 5 / 13; }
    .st-projects { grid-template-columns: 1fr 1fr; column-gap: var(--g); }
    .st-process .st-h { grid-column: 1 / 6; }
    .st-process__lead { grid-column: 8 / 13; align-self: end; }
    .st-plist { grid-column: 5 / 13; grid-template-columns: 1fr 1fr; }
    .st-nlist { grid-column: 5 / 13; }
    .st-label { grid-column: 1 / 5; }
    .st-fl { grid-column: 5 / 13; grid-template-columns: repeat(3, 1fr); }
    .st-slist { grid-column: 5 / 13; grid-template-columns: 1fr 1fr; column-gap: var(--g); }
  }
</style>
