# Canonical address used for Open Graph, canonical links and sitemap.xml
SITE_URL=https://alanadiniz.com

# Optional: a form backend that accepts POST + FormData (Formspree, Web3Forms, Getform, your API).
# Leave empty to send the brief through WhatsApp instead.
