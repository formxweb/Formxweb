# ---------------------------------------------------------------------------
# VERYAXZ STUDIO — ortam değişkenleri. Bu dosyayı .env olarak kopyalayın.
# ---------------------------------------------------------------------------

# Zorunlu: sitenin yayındaki adresi. Canonical, Open Graph, sitemap.xml ve JSON-LD bunu kullanır.
# Vercel'de VERCEL_PROJECT_PRODUCTION_URL, Netlify'da URL otomatik okunur; diğer ortamlarda tanımlayın.
SITE_URL=https://alanadiniz.com

# İsteğe bağlı: teklif formunun gönderileceği servis (POST + FormData kabul eden herhangi bir servis).
# Boş bırakılırsa form, ziyaretçinin kendisinin gönderdiği bir WhatsApp mesajı hazırlar.
PUBLIC_FORM_ENDPOINT=
# Yalnızca gövdede anahtar isteyen servisler için (Web3Forms "access_key").
PUBLIC_FORM_ACCESS_KEY=

# İsteğe bağlı: çerezsiz ziyaret ölçümü (Plausible uyumlu). Boşken hiçbir ölçüm betiği yüklenmez.
PUBLIC_ANALYTICS_DOMAIN=
# Kendi sunucunuzdaki Plausible/uyumlu betik adresi (boşsa plausible.io kullanılır).
PUBLIC_ANALYTICS_SRC=

# İsteğe bağlı: arama motoru doğrulama kodları (yalnızca içerik değeri).
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=
